{
  "manifest_version": 3,
  "name": "Aidomari Web Ingest",
  "version": "1.0.0",
  "description": "ブラウザで閲覧中のWebページ記事を抽出し、Aidomariアプリ（localhost:8877）へワンクリックで送信してAIカード化します。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Aidomariへ送信"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8877/*",
    "http://localhost:8877/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aidomari-browser@aidomari.app",
      "strict_min_version": "109.0",
      "android": {
        "strict_min_version": "120.0"
      }
    }
  }
}
